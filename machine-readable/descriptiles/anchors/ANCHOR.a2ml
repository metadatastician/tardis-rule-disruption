# ANCHOR.a2ml - authoritative anchor for this repository

[metadata]
version = "1.0.0"
last-updated = "2026-09-02"

[anchor]
schema = "hyperpolymath.anchor/1"
repo = "metadatastician/tardis-rule-disruption"
authority = "upstream-canonical"

purpose = [
  "Define canonical semantics and policy boundaries for this repository.",
  "Declare what downstream/satellite repos can extend but not redefine.",
  "Provide a stable golden path and invariant contract for release readiness.",
]

[identity]
project = "TARDIS"
kind = "interactive-experience"
one-sentence = "Seventh Stealth Glider investigation. Totally-Adherent Rule-Disruption Imitation System: a machine that visibly appears to break and simulate disruption of rules while remaining mathematically Conway-lawful underneath. Reserved placeholder in the metadatastician Stealth Glider line."
domain = "Stealth Glider line: reserved seventh investigation, scope not yet specified"

[semantic-authority]
policy = "satellite"
upstream = "metadatastician/stealth-glider-ecosystem"

owns = [
  "Project semantics and specification",
  "Invariant definitions and contractiles",
  "Reference implementation behavior",
]

[implementation-policy]
allowed = ["Rust", "Idris2", "Zig", "Scheme", "Shell", "Just", "AsciiDoc", "Markdown"]
forbidden = ["Node.js", "npm", "Python"]

[golden-path]
smoke-test-command = ["just test"]

success-criteria = [
  "Core tests pass",
  "Quality gates pass",
  "No unresolved critical security findings",
]

[satellite-policy]
must-pin-upstream = true   # this repo pins the hub below
must-declare-authority = true
must-have-anchor = true
must-have-golden-path = true

[semantic-authority-files]
roadmap = "docs/status/ROADMAP.adoc"
lineage = "machine-readable/descriptiles/ECOSYSTEM.a2ml"

[upstream.hub]
repo = "metadatastician/stealth-glider-ecosystem"
path = "machine-readable/descriptiles/ECOSYSTEM.a2ml"
pin = "TODO-tag"
